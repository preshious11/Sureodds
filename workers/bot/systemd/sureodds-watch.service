[Unit]
Description=Sureodds watch (daily missed-generation check, cleanup, health report)

[Service]
Type=oneshot
User=sureodds
WorkingDirectory=/opt/sureodds/workers/bot
# /var/lib/sureodds/runtime/bin/node is a stable symlink, see sureodds-bot.service.
ExecStart=/usr/bin/flock -n /var/lock/sureodds-watch.lock /var/lib/sureodds/runtime/bin/node cron/watch.ts
EnvironmentFile=/opt/sureodds/workers/bot/.env
MemoryMax=200M
MemoryAccounting=yes
NoNewPrivileges=yes
