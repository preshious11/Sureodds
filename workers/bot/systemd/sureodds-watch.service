[Unit]
Description=Sureodds watch (daily missed-generation check, cleanup, health report)

[Service]
Type=oneshot
User=sureodds
WorkingDirectory=/opt/sureodds/workers/bot
ExecStart=/usr/bin/flock -n /var/lock/sureodds-watch.lock /usr/bin/node cron/watch.ts
EnvironmentFile=/opt/sureodds/workers/bot/.env
MemoryMax=200M
MemoryAccounting=yes
NoNewPrivileges=yes
