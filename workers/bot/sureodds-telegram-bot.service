[Unit]
Description=Sureodds Telegram Bot (Long Polling)
After=network.target

[Service]
Type=simple
User=sureodds
# /opt/sureodds-bot is a git working tree, sparse-checked-out to workers/
# only: bot.ts lives at its real repo path and imports ../src/index.ts
# exactly as committed - no copying, no separate build artifact.
WorkingDirectory=/opt/sureodds-bot/workers/bot
ExecStart=/usr/bin/node bot.ts
Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3
StandardOutput=journal
StandardError=journal
Environment="NODE_ENV=production"
EnvironmentFile=/opt/sureodds-bot/workers/bot/.env
MemoryMax=512M
MemoryAccounting=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
