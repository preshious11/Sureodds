# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=<your-telegram-admin-user-id>
TELEGRAM_BOT_USERNAME=<your-bot-username>
TELEGRAM_CHAT_ID=

# Rehearsal safety guard (see rehearsal-guard.ts and
# docs/STAGE1_REHEARSAL_PREREQUISITES.md). Leave REHEARSAL_MODE unset/false
# for production - the guard is then a complete no-op. In rehearsal, set
# REHEARSAL_MODE=true and the two PRODUCTION_* values below so the bot
# refuses to start if the TELEGRAM_* values above ever end up pointing at
# production by mistake. PRODUCTION_BOT_TOKEN_HASH is a sha256, never the
# real token itself:
#   echo -n "<the real production bot token>" | sha256sum
# run that on your own machine, paste only the resulting hash here - never
# the token.
REHEARSAL_MODE=false
PRODUCTION_BOT_TOKEN_HASH=
PRODUCTION_CHAT_IDS=
# Optional. Your own personal Telegram user id, if it is ALSO the
# production admin id (i.e. you don't have a second Telegram account to
# use as the rehearsal admin). The guard then allows this one id through
# as TELEGRAM_ADMIN_IDS even though it's listed in PRODUCTION_CHAT_IDS
# above - it is never allowed as TELEGRAM_CHAT_ID (the group/channel),
# and a negative id (groups/channels are always negative) can never use
# this allowance. Leave blank if you do have a second account.
REHEARSAL_ALLOWED_ADMIN_ID=

# Database (local SQLite file - replaces D1)
SQLITE_DB_PATH=/var/lib/sureodds/sureodds.db
POLLING_OFFSET_FILE=/var/lib/sureodds/polling.offset

# Worker Cron gate (see workers/src/cron.ts handleScheduled - a no-op unless exactly "1")
STAGE3_CRON_ENABLED=1

# Generation/settlement dispatch (deliver-sweep.ts's maybeDispatch* calls)
GITHUB_REPO=<owner>/<repo>
GITHUB_REF=main
GITHUB_DISPATCH_TOKEN=

# Bot/views configuration
TIMEZONE=Africa/Lagos
PAGE_SIZE=5
POST_TIME=09:00
DELIVERY_TIME=09:30
RECAP_TIME=07:45
ALLOWED_SPORTS=
PRO_POLICY_MODE=evidence_v2

# Oracle Object Storage backup
OCI_BACKUP_BUCKET=<your-bucket-name>
OCI_BACKUP_NAMESPACE=<your-object-storage-namespace>
# OCI_CONFIG_PROFILE is only needed if instance principal auth (see
# backup/backup.sh) is not yet set up - leave blank otherwise.
OCI_CONFIG_PROFILE=DEFAULT
