# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=<your-telegram-admin-user-id>
TELEGRAM_BOT_USERNAME=<your-bot-username>
TELEGRAM_CHAT_ID=

# Database (local SQLite file - replaces D1)
SQLITE_DB_PATH=/var/lib/sureodds/sureodds.db
POLLING_OFFSET_FILE=/var/lib/sureodds/polling.offset

# Worker Cron gate (see workers/src/cron.ts handleScheduled - a no-op unless exactly "1")
STAGE3_CRON_ENABLED=1

# Generation/settlement dispatch (deliver-sweep.ts's maybeDispatch* calls)
GITHUB_REPO=<owner>/<repo>
GITHUB_REF=main
GITHUB_DISPATCH_TOKEN=

# Bot/views configuration
TIMEZONE=Africa/Lagos
PAGE_SIZE=5
POST_TIME=09:00
DELIVERY_TIME=09:30
RECAP_TIME=07:45
ALLOWED_SPORTS=
PRO_POLICY_MODE=evidence_v2

# Oracle Object Storage backup
OCI_BACKUP_BUCKET=<your-bucket-name>
OCI_BACKUP_NAMESPACE=<your-object-storage-namespace>
# OCI_CONFIG_PROFILE is only needed if instance principal auth (see
# backup/backup.sh) is not yet set up - leave blank otherwise.
OCI_CONFIG_PROFILE=DEFAULT
