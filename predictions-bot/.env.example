# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890          # channel/group/user id the bot posts to
TELEGRAM_ADMIN_IDS=                      # comma-separated numeric Telegram user ids allowed to run /run /settle /recap /lastrun
ENABLE_COMMANDS=true                     # /top /daily /stats /yesterday via long polling

# ---- Provider keys ----
SHARPAPI_KEY=                            # REQUIRED - the bot refuses to start without it (https://sharpapi.io)
ODDS_API_KEY=                            # recommended (Top ticket + European football) - the-odds-api.com
SPORTSGAMEODDS_KEY=                      # optional (NBA/NFL/MLB/MLS/NCAA/UCL results + odds)
FOOTBALL_DATA_KEY=                       # optional (football-data.org: free football results for settlement)

# ---- Provider chain (queried in this order; results-only providers are not listed) ----
PROVIDER_ORDER=oddsapi,sharpapi,sportsgameodds
TOP_PROVIDER_PRIORITY=oddsapi            # built first for the Top ticket; when it is already in PROVIDER_ORDER it is NOT fetched twice
ALLOWED_SPORTS=football,basketball,american_football,baseball,tennis   # anything else a provider returns is dropped (sport_rejected)
DISABLED_MARKETS=odd_even,prop,winning_margin,ht_ft                    # market ids the picker never selects
CHAIN_MIN_EVENTS=40                      # stop walking the chain once this many priced events are pooled

# ---- The Odds API (500 free credits/month; one odds request = regions x markets credits) ----
# Monthly maths: 9 credits/cycle (3 leagues x 3 credits) x 30 days = ~270, plus settlement
# /scores calls (2 credits per league key per run, a few per day) = ~450 of 500.
ODDS_API_REGIONS=eu                      # one region = 3 credits/key (1 x h2h,spreads,totals). Alternative: uk (bookmakers like Bet365)
ODDSAPI_MAX_CREDITS_PER_CYCLE=9          # hard cap on credits (regions x markets) per generation cycle
ODDSAPI_RESERVE_CREDITS=80               # never spend below this many of x-requests-remaining
ODDSAPI_MIN_KEYS_PER_SPORT=1             # each allowed sport gets >= this many keys before leftovers go by event count
ODDS_API_MIN_INTERVAL_SEC=1.1
ODDS_API_LEAGUE_ALLOWLIST=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_uefa_champs_league,soccer_uefa_europa_league,soccer_efl_champ,soccer_netherlands_eredivisie,soccer_portugal_primeira_liga,soccer_turkey_super_league   # empty = every in-season football key

# ---- SharpAPI: explicit leagues only (no sport-level auto-discovery) ----
SHARPAPI_LEAGUES=england_-_premier_league,spain_-_la_liga,italy_-_serie_a,germany_-_bundesliga,france_-_ligue_1,england_-_championship,netherlands_-_eredivisie,portugal_-_primeira_liga,turkey_-_super_lig,uefa_-_champions_league,uefa_-_europa_league,uefa_-_europa_conference_league,nigeria_-_premier_league,atp,wta,nba,nfl,mlb,euroleague
SHARPAPI_SPORTS=                         # leave empty: a sport-level feed spends the page budget on every league
SHARPAPI_MARKETS=                        # empty = moneyline,spread,total (keeps the page budget small)
SHARPAPI_MAX_PAGES=3                     # pages walked per league feed
SHARPAPI_EVENTS_PER_TARGET=40            # stop after this many priced match events per feed
SHARPAPI_MIN_INTERVAL_SEC=5.5

# ---- SportsGameOdds ----
SGO_SPORTS=                              # empty = no sport filter (all configured leagues are fetched)
SGO_LEAGUES=NBA,NFL,MLB,MLS,NCAAF,NCAAB,UEFA_CHAMPIONS_LEAGUE
SGO_EVENT_LIMIT=50                       # events (=objects) fetched per daily run
SGO_MONTHLY_OBJECT_LIMIT=1000
SGO_ALLOWED_STATS=points,cornerKicks,yellowCards,weightedCards,bothTeamsScored   # other odd stats -> UNSUPPORTED_STAT
SGO_ALLOWED_PERIODS=game,reg,1h,2h       # other periods (quarters, innings, sets) -> UNSUPPORTED_PERIOD
MAX_PLAYER_PROPS=0                       # player-prop lines kept per event (0 = none)

# ---- Picks ----
DAILY_PICKS_TARGET=20                    # safety cap on picks in the one daily list
TOP_COMBINED_ODDS=2.00                   # top-pick ticket target
TOP_LEGS_MIN=2                           # Top Picks is a 2-3 leg accumulator, never a single leg
TOP_LEGS_MAX=3
TOP_ODDS_MAX=2.50                        # hard reject: combined ticket above this is not considered
TOP_LEG_ODDS_MIN=1.05                    # per-leg data-sanity floor only (per-leg odds don't matter)
DAY_WINDOW_END_OFFSET_HOURS=3            # day window ends at local midnight + this many hours
DAILY_COMBINED_MIN_ODDS=10               # keep adding picks until the list ticket reaches this
DAILY_COMBINED_MAX_ODDS=20               # ...and stop before it breaks this
PICK_WINDOW_HOURS=24
MIN_LEAD_MINUTES=30
DAILY_MIN_ODDS=1.20
DAILY_MAX_ODDS=5.00
DAILY_MIN_PROB=0.30
TOP_MIN_PROB=0.62
DAILY_MAX_NEG_EV=-0.05                   # EV is a disagreement floor, not an edge requirement
TOP_MAX_NEG_EV=-0.05                     # market-only candidates skip the EV gate entirely
MAX_PICKS_PER_EVENT=1                    # one selection per real fixture across Top + Daily
DAILY_MAX_MARKET_SHARE=0.25              # one market (e.g. corners totals) <= 25% of the daily list
DAILY_MAX_STAT_SHARE=0.40                # one DERIVED stat (corners/cards/games) <= 40%; "points" is the default stat on main markets and is not capped here
DAILY_MAX_SPORT_SHARE=0.60               # one sport <= 60% whenever >= 2 sports have candidates
DAILY_MAX_PER_LEAGUE=3                   # at most this many daily picks from one competition
MODEL_SHRINK_TO_MARKET=0.80

# ---- Schedule ----
TIMEZONE=Africa/Lagos
POST_TIME=09:00
DELIVERY_TIME=09:30                        # when subscribers get the card, in TIMEZONE (one shared instant; must be after POST_TIME). A PARTIAL slate is retried until then
RECAP_TIME=07:45                         # yesterday's results + stats, posted before picks
# Settlement now runs dynamically: after the latest match of the day ends + sport duration + 15 min buffer
# No configuration needed — it auto-computes based on actual pick times

# ---- Storage ----
DB_PATH=./data/predbot.db                # on Railway attach a volume and set e.g. /data/predbot.db
LOG_LEVEL=INFO
LOG_FILE=                                # rotating log; default ./data/predbot.log next to the DB, 'none' disables

# ---- Daily cache / inline pagination ----
PAGE_SIZE=5                              # picks per inline-keyboard page
# SQLite cache: retry failed providers after 15 minutes; retain seven days.
CACHE_RETRY_SECONDS=900
CACHE_RETENTION_DAYS=7
