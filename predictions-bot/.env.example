# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890          # channel/group/user id the bot posts to
TELEGRAM_ADMIN_IDS=                      # optional, comma-separated user ids allowed to run /run commands
ENABLE_COMMANDS=true                     # /top /daily /stats /yesterday via long polling

# ---- API keys (leave blank to disable a provider) ----
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io   # or api-football-v1.p.rapidapi.com for RapidAPI keys
SPORTSGAMEODDS_KEY=
SHARPAPI_KEY=
ODDS_API_KEY=                            # the-odds-api.com; football + tennis only, tried first for Top picks
ODDS_API_REGIONS=eu                      # one region keeps credit cost at 3/key (1 x 3 markets)
ODDSAPI_MAX_CREDITS_PER_CYCLE=15         # hard cap on credits (regions x markets) per cycle
ODDSAPI_RESERVE_CREDITS=50              # never spend below this many of x-requests-remaining
ODDS_API_MIN_INTERVAL_SEC=1.1

# ---- Provider chain (checked in this order; next one is used only if the pool is still thin) ----
PROVIDER_ORDER=api_football,sportsgameodds,sharpapi
TOP_PROVIDER_PRIORITY=oddsapi            # tried first to build the ~2.00 combined Top ticket; falls back to PROVIDER_ORDER if it can't supply enough
CHAIN_MIN_EVENTS=40                      # stop walking the chain once this many priced events are pooled
SGO_SPORTS=                                    # empty = all sports auto-discovered from provider catalog
SGO_LEAGUES=
SGO_EVENT_LIMIT=25                       # events (=objects) fetched per daily run
SHARPAPI_LEAGUES=                        # optional per-league feeds, e.g. nba,nfl,mlb,nhl
SHARPAPI_SPORTS=auto                      # auto-discovers all accessible sports from provider /sports catalog
SHARPAPI_MARKETS=                         # empty = all markets; defaults to moneyline,spread,total to stay within free-tier page budget
SHARPAPI_MAX_PAGES=12                    # pages walked per league/sport feed
SHARPAPI_EVENTS_PER_TARGET=40            # stop after this many priced match events per feed
APIF_LEAGUE_IDS=                         # optional API-Football league ids to restrict, e.g. 39,140,135,78,61,2
APIF_DAILY_LIMIT=100
APIF_PREDICTIONS_PER_RUN=25
SGO_MONTHLY_OBJECT_LIMIT=1000
SHARPAPI_MIN_INTERVAL_SEC=5.5

# ---- Picks ----
DAILY_PICKS_TARGET=20                    # safety cap on picks in the one daily list
TOP_COMBINED_ODDS=2.00                   # top-pick ticket target
TOP_LEGS_MIN=2                           # Top Picks is a 2-3 leg accumulator, never a single leg
TOP_LEGS_MAX=3
TOP_ODDS_MAX=2.50                        # hard reject: combined ticket above this is not considered
TOP_LEG_ODDS_MIN=1.05                    # per-leg data-sanity floor only (per-leg odds don't matter)
DAY_WINDOW_END_OFFSET_HOURS=3            # day window ends at local midnight + this many hours
DAILY_COMBINED_MIN_ODDS=10               # keep adding picks until the list ticket reaches this
DAILY_COMBINED_MAX_ODDS=20               # ...and stop before it breaks this
PICK_WINDOW_HOURS=24
MIN_LEAD_MINUTES=30
DAILY_MIN_ODDS=1.30
DAILY_MAX_ODDS=5.00
DAILY_MIN_PROB=0.30
TOP_MIN_PROB=0.62
DAILY_MAX_NEG_EV=-0.05                   # EV is a disagreement floor, not an edge requirement
TOP_MAX_NEG_EV=-0.05                     # market-only candidates skip the EV gate entirely
MAX_PICKS_PER_EVENT=2
MAX_PLAYER_PROPS=2
DAILY_MAX_MARKET_SHARE=0.25              # one market (e.g. corners totals) <= 25% of the daily list
DAILY_MAX_STAT_SHARE=0.40                # one stat (e.g. corners across totals AND 1X2) <= 40% of the daily list
DAILY_MAX_SPORT_SHARE=0.50               # one sport <= 50% whenever >= 2 sports have candidates
DAILY_MAX_PER_LEAGUE=3                   # at most this many daily picks from one competition
MODEL_SHRINK_TO_MARKET=0.80

# ---- Schedule ----
TIMEZONE=Africa/Lagos
POST_TIME=09:00
RECAP_TIME=07:45                         # yesterday's results + stats, posted before picks
# Settlement now runs dynamically: after the latest match of the day ends + sport duration + 15 min buffer
# No configuration needed — it auto-computes based on actual pick times

# ---- Storage ----
DB_PATH=./data/predbot.db                # on Railway attach a volume and set e.g. /data/predbot.db
LOG_LEVEL=INFO

# ---- Daily cache / inline pagination ----
PAGE_SIZE=5                              # picks per inline-keyboard page
# SQLite cache: retry failed providers after 15 minutes; retain seven days.
CACHE_RETRY_SECONDS=900
CACHE_RETENTION_DAYS=7
