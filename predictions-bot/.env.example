# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890          # configured community group/supergroup/channel id; use your real destination
TELEGRAM_ADMIN_IDS=                      # comma-separated numeric Telegram user ids allowed to run /run /settle /recap /lastrun /menu
ENABLE_COMMANDS=true                     # /top /daily /stats /yesterday via long polling
SUBSCRIBER_DELIVERY_ENABLED=false        # community mode: no automatic subscriber picks/recaps/live DMs; community posts/live updates, settlement and private commands continue

# ---- Provider keys ----
SHARPAPI_KEY=                            # REQUIRED - the bot refuses to start without it (https://sharpapi.io)
ODDS_API_KEY=                            # recommended (Top ticket + European football) - the-odds-api.com
SPORTSGAMEODDS_KEY=                      # optional (NBA/NFL/MLB/MLS/NCAA/UCL results + odds)
FOOTBALL_DATA_KEY=                       # optional (football-data.org: free football results for settlement)
ESPN_RESULTS=1                           # free keyless results for every sport we pick (Europa/Conference, Super Lig, Nigeria, tennis, US sports)
EUROLEAGUE_RESULTS=1                     # free keyless Euroleague results

# ---- Provider chain (queried in this order; results-only providers are not listed) ----
PROVIDER_ORDER=oddsapi,sharpapi,sportsgameodds
# Completeness normally requires REQUIRED_PROVIDERS to report complete.
# The fallback policy below also permits a usable slate from complete backups.
# Optional provider failures are recorded as degraded coverage.
REQUIRED_PROVIDERS=sharpapi
# Publish a usable backup slate when a required provider is incomplete.
PROVIDER_FALLBACK_ENABLED=true
# Minimum predictions required for backup-provider publication (also needs Top/Daily).
FALLBACK_MIN_PREDICTIONS=20
ALLOWED_SPORTS=football,basketball,american_football,baseball,tennis   # anything else a provider returns is dropped (sport_rejected)
DISABLED_MARKETS=odd_even,prop,winning_margin,ht_ft                    # market ids Top and Daily never promote (still predicted, still in All Predictions)

# ---- The Odds API (500 free credits/month; one odds request = regions x markets credits) ----
# Monthly maths: 9 credits/cycle (3 leagues x 3 credits) x 30 days = ~270, plus settlement
# /scores calls (2 credits per league key per run, a few per day) = ~450 of 500.
ODDS_API_REGIONS=eu                      # one region = 3 credits/key (1 x h2h,spreads,totals). Alternative: uk (bookmakers like Bet365)
PRICE_MODE=median                        # median = what a typical book offers (card: "Odds: 2.10 (median of 6 books)"); best = highest price + its bookmaker ("Odds: 2.35 (Bet365)")
# ODDS_API_REGIONS=uk adds UK-facing books (Bet365, William Hill...) at the same 3 credits/key; combine with PRICE_MODE=best to show a named book
ODDSAPI_MAX_CREDITS_PER_CYCLE=9          # hard cap on credits (regions x markets) per generation cycle
ODDSAPI_RESERVE_CREDITS=80               # never spend below this many of x-requests-remaining
ODDSAPI_SETTLEMENT_RESERVE_CREDITS=0     # credits above that reserve only settlement (/scores) may spend; generation stops earlier. 0 = off
ODDSAPI_MIN_KEYS_PER_SPORT=1             # each allowed sport gets >= this many keys before leftovers go by event count
ODDS_API_MIN_INTERVAL_SEC=1.1
ODDS_API_LEAGUE_ALLOWLIST=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_uefa_champs_league,soccer_uefa_europa_league,soccer_uefa_nations_league,soccer_efl_champ,soccer_netherlands_eredivisie,soccer_portugal_primeira_liga,soccer_turkey_super_league   # empty = every in-season football key

# ---- SharpAPI: explicit leagues only (no sport-level auto-discovery) ----
SHARPAPI_LEAGUES=england_-_premier_league,spain_-_la_liga,italy_-_serie_a,germany_-_bundesliga,france_-_ligue_1,england_-_championship,netherlands_-_eredivisie,portugal_-_primeira_liga,turkey_-_super_lig,uefa_-_champions_league,uefa_-_europa_league,uefa_-_europa_conference_league,uefa_-_nations_league,concacaf_-_nations_league,world_-_international_friendlies,nigeria_-_premier_league,atp,wta,nba,nfl,mlb,euroleague
SHARPAPI_SPORTS=                         # leave empty: a sport-level feed spends the page budget on every league
SHARPAPI_MARKETS=moneyline,spread,total   # market aliases, used for sports without an exact list below
SHARPAPI_MARKETS_FOOTBALL=moneyline,point_spread,total_goals,double_chance,draw_no_bet,both_teams_to_score,team_total_goals   # exact names: no shots/fouls/corners rows; ~29 rows per match
SHARPAPI_MARKETS_BASEBALL=moneyline,run_line,total_runs
SHARPAPI_MAIN_LINES_ONLY=1              # is_main_line=true: alternate lines are ~70% of a match's rows (0 = all lines)
SHARPAPI_MAX_PAGES=6                     # hard ceiling of pages walked per league feed
SHARPAPI_MONTHLY_REQUEST_LIMIT=3000      # OUR budget (SharpAPI publishes no monthly quota; free tier = 12 requests/min)
SHARPAPI_MAX_REQUESTS_PER_GENERATION=60  # ceiling per generation; the daily share of the monthly budget applies too
SHARPAPI_LEAGUE_PRIORITY=england_-_premier_league,spain_-_la_liga,italy_-_serie_a,germany_-_bundesliga,france_-_ligue_1,uefa_-_champions_league
SHARPAPI_EVENTS_PER_TARGET=40            # stop after this many priced match events per feed
SHARPAPI_MIN_INTERVAL_SEC=5.5

# ---- SportsGameOdds ----
SGO_SPORTS=                              # empty = no sport filter (all configured leagues are fetched)
SGO_LEAGUES=NBA,NFL,MLB,MLS,NCAAF,NCAAB,UEFA_CHAMPIONS_LEAGUE
SGO_EVENT_LIMIT=50                       # events (=objects) fetched per daily run
SGO_MONTHLY_OBJECT_LIMIT=2500             # fallback only; the live cap is read from /account/usage
SGO_MIN_INTERVAL_SEC=6.5                  # Amateur plan = 10 requests/minute
SGO_ALLOWED_STATS=points,cornerKicks,yellowCards,weightedCards,bothTeamsScored   # other odd stats -> UNSUPPORTED_STAT
SGO_ALLOWED_PERIODS=game,reg,1h,2h       # other periods (quarters, innings, sets) -> UNSUPPORTED_PERIOD
MAX_PLAYER_PROPS=0                       # player-prop lines kept per event (0 = none)

# ---- Picks ----
DAILY_PICKS_TARGET=12                    # safety cap on picks in the one daily list
TOP_COMBINED_ODDS=2.00                   # top-pick ticket target
TOP_LEGS_MAX=3                           # Top ticket holds 1-3 legs; a strong single can satisfy the target band alone
TOP_ODDS_MAX=2.50                        # hard reject: combined ticket above this is not considered
DAY_WINDOW_END_OFFSET_HOURS=3            # day window ends at local midnight + this many hours
DAILY_COMBINED_MIN_ODDS=10               # keep adding picks until the DAILY ticket alone (Top excluded) reaches this
DAILY_COMBINED_MAX_ODDS=12               # ...and stop before it breaks this
PICK_WINDOW_HOURS=24
MIN_LEAD_MINUTES=30
DAILY_MIN_ODDS=1.20
DAILY_MAX_ODDS=5.00
DAILY_MIN_PROB=0.55                      # THE Daily probability floor: a leg below this is never a Daily candidate
TOP_MIN_PROB=0.62
DAILY_MAX_NEG_EV=-0.05                   # EV is a disagreement floor, not an edge requirement
TOP_MAX_NEG_EV=-0.05                     # market-only candidates skip the EV gate entirely
DAILY_MAX_MARKET_SHARE=0.25              # one market (e.g. corners totals) <= 25% of the daily list
DAILY_MAX_STAT_SHARE=0.40                # one DERIVED stat (corners/cards/games) <= 40%; "points" is the default stat on main markets and is not capped here
DAILY_MAX_SPORT_SHARE=0.60               # one sport <= 60% whenever >= 2 sports have candidates
TOP_MIN_BOOKS=3                          # distinct books, independent of provider count
DAILY_MAX_PER_LEAGUE=3                   # at most this many daily picks from one competition
MODEL_SHRINK_TO_MARKET=0.80
INDEPENDENT_MODEL_MODE=shadow             # off | shadow (store p_independent beside p_model) | independent (p_model = history-based estimate where one exists)
STRENGTH_HALF_LIFE_DAYS=365               # provisional; choose with tools/backtest_football.py --select on real history
STRENGTH_PRIOR=8
STRENGTH_MIN_MATCHES=5

# ---- Schedule ----
LIVE_UPDATES_ENABLED=true                # keep enabled for community Match Started/Ended and existing live settlement
LIVE_POLL_MINUTES=5                      # >= 1; status checks for stored picks near kickoff
TIMEZONE=Africa/Lagos
POST_TIME=09:00                          # generation + configured community Top/Daily publication (static cards)
DELIVERY_TIME=09:30                        # when subscribers get the card, in TIMEZONE (one shared instant; must be after POST_TIME). A PARTIAL slate is retried until then
RECAP_TIME=07:45                         # yesterday's results + stats, posted before picks
# Settlement now runs dynamically: after the latest match of the day ends + sport duration + 15 min buffer
# No configuration needed — it auto-computes based on actual pick times

# ---- Storage ----
DB_PATH=./data/predbot.db                # on Railway attach a volume and set e.g. /data/predbot.db
LOG_LEVEL=INFO
LOG_FILE=                                # rotating log; default ./data/predbot.log next to the DB, 'none' disables

# ---- Daily cache / inline pagination ----
PAGE_SIZE=5                              # picks per inline-keyboard page
VIEW_NAVIGATION=edit_pages               # edit_pages = a page turn edits its message, a view switch sends a new one; new = every press sends a new message; edit = every press edits the pressed message
# SQLite cache: retry failed providers after 15 minutes; retain seven days.
CACHE_RETRY_SECONDS=900
CACHE_RETENTION_DAYS=7
# Private Ticket Audit; constructed lazily only after private ticket intake.
# Enable only on a confirmed free-tier project with billing disabled. No paid fallback.
GEMINI_API_KEY=
# Working free text model; Developer API Search grounding is paid-only and blocked.
GEMINI_AUDIT_MODEL=gemini-3.5-flash-lite
AUDIT_GEMINI_ENABLED=false
AUDIT_GEMINI_FREE_TIER_CONFIRMED=false
AUDIT_GEMINI_MAX_REQUESTS_PER_DAY=20
# Ticket Audit booking-code intake (retrieve only; no conversion/booking/betting). All off by default.
# The bot asks which bookmaker a code is from; nothing is fetched until the user picks one.
AUDIT_BOOKING_CODES_ENABLED=false
# EXPERIMENTAL: SportyBet's undocumented anonymous web share-code route. May change or block without notice.
SPORTYBET_DIRECT_ENABLED=false
SPORTYBET_DIRECT_MAX_REQUESTS_PER_DAY=50
# MyBetCode GET /api/v1/retrieve only (sportybet:ng, bet9ja, nairabet). Free tier: 10/day, 100/month.
MYBETCODE_ENABLED=false
MYBETCODE_API_KEY=
MYBETCODE_MAX_REQUESTS_PER_DAY=10
MYBETCODE_MAX_REQUESTS_PER_MONTH=100
