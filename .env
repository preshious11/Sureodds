CHAIN_MIN_EVENTS=40                      # stop walking the chain once this many priced events are pooled
SGO_SPORTS=SOCCER,BASKETBALL,TENNIS,HOCKEY,BASEBALL,FOOTBALL
SGO_LEAGUES=NBA,UEFA_CHAMPIONS_LEAGUE,MLB,MLS,NCAAB,NCAAF,NFL,NHL  # exact IDs your free-tier key allows (queried live)
SGO_EVENT_LIMIT=25                       # events (=objects) fetched per daily run
SHARPAPI_LEAGUES=mlb,mls,nba,nfl,nhl     # focused leagues; the unfiltered feed is futures/outrights-first and misses the 24h window
