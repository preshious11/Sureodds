SETTLE_INTERVAL_MIN=30

# ---- Storage ----
DB_PATH=./data/predbot.db                # on Railway attach a volume and set e.g. /data/predbot.db
LOG_LEVEL=INFO

# ---- Daily cache / inline pagination ----
REDIS_URL=                               # optional (pip install redis); empty = in-process TTL cache
PAGE_SIZE=5                              # picks per inline-keyboard page
